---
import {
  getSelectedDegrees,
  listCourses,
  listDegrees,
  listPlanEntries,
  listRequirements,
} from "../lib/db";
import { getElectives, getRecommendations, offeringPatternLabel, planningNote } from "../lib/recommend";
import "../styles.css";

const planEntries = listPlanEntries();
const plannedCodes = new Set(planEntries.map((entry) => entry.courseCode));
const courseOptions = listCourses().filter((course) => !plannedCodes.has(course.code));
const requirementOptions = listRequirements();

const degreeOptions = listDegrees();
const selectedDegrees = getSelectedDegrees();
const selectedCodes = new Set(selectedDegrees.map((degree) => degree.code));
const mode = selectedCodes.size >= 2 ? "double" : "single";
const recommendations = getRecommendations();
const electives = getElectives();

// Group the study plan by year/semester for display. listPlanEntries is
// already ordered by (year, semester), so insertion order into the map
// gives chronological groups for free.
const planByTerm = new Map<string, typeof planEntries>();
for (const entry of planEntries) {
  const term = `${entry.year} ${entry.semester}`;
  const group = planByTerm.get(term);
  if (group) {
    group.push(entry);
  } else {
    planByTerm.set(term, [entry]);
  }
}
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ANU Degree Planner</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Study plan</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>Study plan</h1>
      <p>
        A minimal ANU degree planner: plan a seeded course into a year and
        semester, and associate it with the degree requirement it counts
        towards. State lives in SQLite on the machine's volume, so it
        survives a reload and a redeploy.
      </p>

      <section>
        <h2>Degree(s)</h2>
        <p>Choose Single Degree or Double Degree, then tick the matching number of degrees below.</p>
        <form method="post" action="/api/degree-selection">
          <fieldset>
            <legend>Mode</legend>
            <label for="mode-single">
              <input type="radio" id="mode-single" name="mode" value="single" checked={mode === "single"} />
              Single Degree
            </label>
            <label for="mode-double">
              <input type="radio" id="mode-double" name="mode" value="double" checked={mode === "double"} />
              Double Degree
            </label>
          </fieldset>
          <fieldset>
            <legend>Degrees</legend>
            {
              degreeOptions.map((degree) => (
                <label for={`degree-${degree.code}`}>
                  <input
                    type="checkbox"
                    id={`degree-${degree.code}`}
                    name="degreeCode"
                    value={degree.code}
                    checked={selectedCodes.has(degree.code)}
                  />
                  {degree.name}
                </label>
              ))
            }
          </fieldset>
          <button>Update degree selection</button>
        </form>
        {
          selectedDegrees.length > 0 && (
            <p>Currently selected: {selectedDegrees.map((degree) => degree.name).join(" + ")}</p>
          )
        }
      </section>

      <p>
        Historical offering patterns below (in "What can I take next?" and "Browse
        Electives") reflect past semesters in the seeded data only — they are not a
        prediction or guarantee that ANU will run a course again in any particular
        future semester.
      </p>

      <section>
        <h2>What can I take next?</h2>
        {
          selectedDegrees.length === 0 ? (
            <p>Select at least one degree above to see recommendations.</p>
          ) : (
            <ul id="recommendations">
              {
                recommendations.map((rec) => (
                  <li>
                    {rec.courseCode} ({rec.courseTitle}) —{" "}
                    {rec.status === "completed" && "completed"}
                    {rec.status === "available" &&
                      (rec.unlocks.length > 0
                        ? `available now — unlocks ${rec.unlocks.join(", ")}`
                        : "available now")}
                    {rec.status === "blocked" && `blocked — needs ${rec.missing.join(", ")}`}
                    {offeringPatternLabel(rec.offeringPattern) && <p>{offeringPatternLabel(rec.offeringPattern)}</p>}
                    {planningNote(rec.offeringPattern) && <p>{planningNote(rec.offeringPattern)}</p>}
                    {rec.status !== "completed" && (
                      <form method="post" action="/api/completed-courses">
                        <input type="hidden" name="courseCode" value={rec.courseCode} />
                        <button>Mark completed</button>
                      </form>
                    )}
                    {rec.status === "available" &&
                      (plannedCodes.has(rec.courseCode) ? (
                        <p>Already in your study plan.</p>
                      ) : (
                        <form method="post" action="/api/plan-entries">
                          <input type="hidden" name="courseCode" value={rec.courseCode} />
                          <input type="hidden" name="requirementCode" value={rec.requirementCode ?? ""} />
                          <label for={`plan-year-${rec.courseCode}`}>Year</label>
                          <input
                            id={`plan-year-${rec.courseCode}`}
                            name="year"
                            type="number"
                            required
                            min="2024"
                            max="2035"
                          />
                          <label for={`plan-semester-${rec.courseCode}`}>Semester</label>
                          <select id={`plan-semester-${rec.courseCode}`} name="semester" required>
                            <option value="S1">S1</option>
                            <option value="S2">S2</option>
                          </select>
                          <button>Plan course</button>
                        </form>
                      ))}
                  </li>
                ))
              }
            </ul>
          )
        }
      </section>

      <section>
        <h2>Browse Electives</h2>
        <p>Courses that don't count towards either of your selected degrees, but can still be planned.</p>
        {
          electives.length === 0 ? (
            <p>No electives in the seeded catalogue right now.</p>
          ) : (
            <ul id="electives">
              {
                electives.map((elective) => (
                  <li>
                    {elective.courseCode} ({elective.courseTitle}) — {elective.units} units —{" "}
                    {elective.status === "completed" && "completed"}
                    {elective.status === "available" && "available now"}
                    {elective.status === "blocked" && `blocked — needs ${elective.missing.join(", ")}`}
                    {offeringPatternLabel(elective.offeringPattern) && (
                      <p>{offeringPatternLabel(elective.offeringPattern)}</p>
                    )}
                    {planningNote(elective.offeringPattern) && <p>{planningNote(elective.offeringPattern)}</p>}
                    {elective.status === "available" &&
                      (plannedCodes.has(elective.courseCode) ? (
                        <p>Already in your study plan.</p>
                      ) : (
                        <form method="post" action="/api/plan-entries">
                          <input type="hidden" name="courseCode" value={elective.courseCode} />
                          <label for={`elective-year-${elective.courseCode}`}>Year</label>
                          <input
                            id={`elective-year-${elective.courseCode}`}
                            name="year"
                            type="number"
                            required
                            min="2024"
                            max="2035"
                          />
                          <label for={`elective-semester-${elective.courseCode}`}>Semester</label>
                          <select id={`elective-semester-${elective.courseCode}`} name="semester" required>
                            <option value="S1">S1</option>
                            <option value="S2">S2</option>
                          </select>
                          <button>Plan course</button>
                        </form>
                      ))}
                  </li>
                ))
              }
            </ul>
          )
        }
      </section>

      <section>
        <h2>My Study Plan</h2>
        {
          planByTerm.size === 0 ? (
            <p>Nothing planned yet — mark a course above, or add any course below.</p>
          ) : (
            [...planByTerm.entries()].map(([term, entries]) => (
              <div>
                <h3>{term}</h3>
                <ul>
                  {
                    entries.map((entry) => (
                      <li>
                        {entry.courseCode} ({entry.courseTitle})
                        {entry.requirementCode
                          ? ` — ${entry.requirementCode} (${entry.requirementName})`
                          : " — elective"}
                        <form method="post" action="/api/plan-entries/remove">
                          <input type="hidden" name="courseCode" value={entry.courseCode} />
                          <button>Remove</button>
                        </form>
                      </li>
                    ))
                  }
                </ul>
              </div>
            ))
          )
        }

        <h3>Add any other course</h3>
        <p>
          For an elective or out-of-degree course, or to plan ahead for something not yet
          recommended above.
        </p>
        {
          courseOptions.length === 0 ? (
            <p>Every seeded course is already in your plan.</p>
          ) : (
            <form method="post" action="/api/plan-entries">
              <label for="courseCode">Course</label>
              <select id="courseCode" name="courseCode" required>
                {
                  courseOptions.map((course) => (
                    <option value={course.code}>
                      {course.code} — {course.title}
                    </option>
                  ))
                }
              </select>

              <label for="year">Year</label>
              <input id="year" name="year" type="number" required min="2024" max="2035" />

              <label for="semester">Semester</label>
              <select id="semester" name="semester" required>
                <option value="S1">S1</option>
                <option value="S2">S2</option>
              </select>

              <label for="requirementCode">Requirement (optional)</label>
              <select id="requirementCode" name="requirementCode">
                <option value="">— none (elective) —</option>
                {
                  requirementOptions.map((requirement) => (
                    <option value={requirement.code}>
                      {requirement.degreeName}: {requirement.name}
                    </option>
                  ))
                }
              </select>

              <button>Add to plan</button>
            </form>
          )
        }
      </section>
    </main>
  </body>
</html>
