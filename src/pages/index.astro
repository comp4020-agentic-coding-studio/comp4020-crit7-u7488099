---
import {
  getSelectedDegrees,
  listCourses,
  listDegrees,
  listPlanEntries,
  listRequirements,
} from "../lib/db";
import { getElectives, getRecommendations, offeringPatternLabel, planningNote } from "../lib/recommend";
import "../styles.css";

const planEntries = listPlanEntries();
const plannedCodes = new Set(planEntries.map((entry) => entry.courseCode));
const allCourses = listCourses();
const courseOptions = allCourses.filter((course) => !plannedCodes.has(course.code));
const courseUnitsByCode = new Map(allCourses.map((course) => [course.code, course.units]));
const requirementOptions = listRequirements();
const requirementNameByCode = new Map(requirementOptions.map((requirement) => [requirement.code, requirement.name]));

const degreeOptions = listDegrees();
const selectedDegrees = getSelectedDegrees();
const selectedCodes = new Set(selectedDegrees.map((degree) => degree.code));
const mode = selectedCodes.size >= 2 ? "double" : "single";
const recommendations = getRecommendations();
const electives = getElectives();

const statusLabel = { completed: "Completed", available: "Available now", blocked: "Blocked" } as const;

// Group the study plan by year/semester for display. listPlanEntries is
// already ordered by (year, semester), so insertion order into the map
// gives chronological groups for free.
const planByTerm = new Map<string, typeof planEntries>();
for (const entry of planEntries) {
  const term = `${entry.year} ${entry.semester}`;
  const group = planByTerm.get(term);
  if (group) {
    group.push(entry);
  } else {
    planByTerm.set(term, [entry]);
  }
}
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ANU Degree Planner</title>
  </head>
  <body>
    <nav class="site-nav" aria-label="site">
      <span class="site-brand">ANU Degree Planner</span>
      <div class="site-nav-links">
        <a href="/">Study plan</a>
        <a href="/readme/">About</a>
      </div>
    </nav>
    <main>
      <div class="page-intro">
        <h1>ANU Degree Planner</h1>
        <p class="subtitle">
          See what you can take next, keep your future study pathways open, and build a
          semester-by-semester plan toward your degree(s).
        </p>
      </div>

      <section class="panel" aria-labelledby="setup-heading">
        <div class="panel-header">
          <h2 id="setup-heading">Degree setup</h2>
          <p class="panel-hint">
            Choose Single Degree or Double Degree, then tick the matching number of degrees below.
          </p>
        </div>
        <form method="post" action="/api/degree-selection" class="setup-form">
          <fieldset class="mode-select">
            <legend>Mode</legend>
            <label class="mode-option" for="mode-single">
              <input type="radio" id="mode-single" name="mode" value="single" checked={mode === "single"} />
              Single Degree
            </label>
            <label class="mode-option" for="mode-double">
              <input type="radio" id="mode-double" name="mode" value="double" checked={mode === "double"} />
              Double Degree
            </label>
          </fieldset>
          <fieldset class="degree-select">
            <legend>Degrees</legend>
            {
              degreeOptions.map((degree) => (
                <label class="degree-option" for={`degree-${degree.code}`}>
                  <input
                    type="checkbox"
                    id={`degree-${degree.code}`}
                    name="degreeCode"
                    value={degree.code}
                    checked={selectedCodes.has(degree.code)}
                  />
                  <span class="degree-option-name">{degree.name}</span>
                  <span class="degree-option-code">{degree.code}</span>
                </label>
              ))
            }
          </fieldset>
          <button class="btn btn-primary">Update degree selection</button>
        </form>
        {
          selectedDegrees.length > 0 && (
            <p class="selected-degrees">
              <span class="selected-degrees-label">Currently selected:</span>
              {selectedDegrees.map((degree) => (
                <span class="chip">{degree.name}</span>
              ))}
            </p>
          )
        }
      </section>

      <p class="disclaimer">
        Historical offering patterns below (in "What can I take next?" and "Browse
        Electives") reflect past semesters in the seeded data only — they are not a
        prediction or guarantee that ANU will run a course again in any particular
        future semester.
      </p>

      <section class="panel panel--focus" aria-labelledby="recommendations-heading">
        <div class="panel-header">
          <h2 id="recommendations-heading">What can I take next?</h2>
          <p class="panel-hint">Courses relevant to your selected degree(s) — the ones worth planning first.</p>
        </div>
        {
          selectedDegrees.length === 0 ? (
            <p>Select at least one degree above to see recommendations.</p>
          ) : (
            <ul id="recommendations">
              {
                recommendations.map((rec) => {
                  const units = courseUnitsByCode.get(rec.courseCode);
                  const requirementName = rec.requirementCode ? requirementNameByCode.get(rec.requirementCode) : null;
                  return (
                    <li class={`course-card course-card--${rec.status}`}>
                      <div class="course-card-head">
                        <span class="course-code">{rec.courseCode}</span>
                        <span class={`status-badge status-badge--${rec.status}`}>{statusLabel[rec.status]}</span>
                      </div>
                      <p class="course-title">{rec.courseTitle}</p>
                      <p class="course-meta">
                        {rec.requirementCode && (
                          <span class="meta-chip">
                            Requirement: {rec.requirementCode}
                            {requirementName && ` (${requirementName})`}
                          </span>
                        )}
                        {units !== undefined && <span class="meta-chip">{units} units</span>}
                      </p>
                      {rec.status === "blocked" && <p class="course-detail">Still needs: {rec.missing.join(", ")}</p>}
                      {rec.status === "available" && rec.unlocks.length > 0 && (
                        <p class="course-detail course-detail--unlocks">
                          Completing this unlocks {rec.unlocks.join(", ")}.
                        </p>
                      )}
                      {offeringPatternLabel(rec.offeringPattern) && (
                        <p class="offering-pattern">{offeringPatternLabel(rec.offeringPattern)}</p>
                      )}
                      {planningNote(rec.offeringPattern) && (
                        <p class="planning-note">{planningNote(rec.offeringPattern)}</p>
                      )}
                      <div class="course-actions">
                        {rec.status !== "completed" && (
                          <form method="post" action="/api/completed-courses" class="action-form">
                            <input type="hidden" name="courseCode" value={rec.courseCode} />
                            <button class="btn btn-ghost">Mark completed</button>
                          </form>
                        )}
                        {rec.status === "available" &&
                          (plannedCodes.has(rec.courseCode) ? (
                            <p class="already-planned">Already in your study plan.</p>
                          ) : (
                            <form method="post" action="/api/plan-entries" class="action-form">
                              <input type="hidden" name="courseCode" value={rec.courseCode} />
                              <input type="hidden" name="requirementCode" value={rec.requirementCode ?? ""} />
                              <label for={`plan-year-${rec.courseCode}`}>Year</label>
                              <input
                                id={`plan-year-${rec.courseCode}`}
                                name="year"
                                type="number"
                                required
                                min="2024"
                                max="2035"
                              />
                              <label for={`plan-semester-${rec.courseCode}`}>Semester</label>
                              <select id={`plan-semester-${rec.courseCode}`} name="semester" required>
                                <option value="S1">S1</option>
                                <option value="S2">S2</option>
                              </select>
                              <button class="btn btn-primary">Plan course</button>
                            </form>
                          ))}
                      </div>
                    </li>
                  );
                })
              }
            </ul>
          )
        }
      </section>

      <section class="panel panel--secondary" aria-labelledby="electives-heading">
        <div class="panel-header">
          <h2 id="electives-heading">Browse Electives</h2>
          <p class="panel-hint">
            Courses that don't count towards either of your selected degrees, but can still be planned.
          </p>
        </div>
        {
          electives.length === 0 ? (
            <p>No electives in the seeded catalogue right now.</p>
          ) : (
            <ul id="electives">
              {
                electives.map((elective) => (
                  <li class={`course-card course-card--${elective.status}`}>
                    <div class="course-card-head">
                      <span class="course-code">{elective.courseCode}</span>
                      <span class={`status-badge status-badge--${elective.status}`}>
                        {statusLabel[elective.status]}
                      </span>
                    </div>
                    <p class="course-title">{elective.courseTitle}</p>
                    <p class="course-meta">
                      <span class="meta-chip">{elective.units} units</span>
                    </p>
                    {elective.status === "blocked" && (
                      <p class="course-detail">Still needs: {elective.missing.join(", ")}</p>
                    )}
                    {offeringPatternLabel(elective.offeringPattern) && (
                      <p class="offering-pattern">{offeringPatternLabel(elective.offeringPattern)}</p>
                    )}
                    {planningNote(elective.offeringPattern) && (
                      <p class="planning-note">{planningNote(elective.offeringPattern)}</p>
                    )}
                    {elective.status === "available" &&
                      (plannedCodes.has(elective.courseCode) ? (
                        <p class="already-planned">Already in your study plan.</p>
                      ) : (
                        <div class="course-actions">
                          <form method="post" action="/api/plan-entries" class="action-form">
                            <input type="hidden" name="courseCode" value={elective.courseCode} />
                            <label for={`elective-year-${elective.courseCode}`}>Year</label>
                            <input
                              id={`elective-year-${elective.courseCode}`}
                              name="year"
                              type="number"
                              required
                              min="2024"
                              max="2035"
                            />
                            <label for={`elective-semester-${elective.courseCode}`}>Semester</label>
                            <select id={`elective-semester-${elective.courseCode}`} name="semester" required>
                              <option value="S1">S1</option>
                              <option value="S2">S2</option>
                            </select>
                            <button class="btn btn-primary">Plan course</button>
                          </form>
                        </div>
                      ))}
                  </li>
                ))
              }
            </ul>
          )
        }
      </section>

      <section class="panel" aria-labelledby="plan-heading">
        <div class="panel-header">
          <h2 id="plan-heading">My Study Plan</h2>
          <p class="panel-hint">Your plan, grouped by year and semester.</p>
        </div>
        {
          planByTerm.size === 0 ? (
            <p>Nothing planned yet — mark a course above, or add any course below.</p>
          ) : (
            <div class="term-groups">
              {
                [...planByTerm.entries()].map(([term, entries]) => (
                  <div class="term-group">
                    <h3 class="term-heading">{term}</h3>
                    <ul class="term-entries">
                      {
                        entries.map((entry) => (
                          <li class="plan-entry">
                            <span class="plan-entry-course">
                              {entry.courseCode} ({entry.courseTitle})
                            </span>
                            <span class="plan-entry-requirement">
                              {entry.requirementCode
                                ? ` — ${entry.requirementCode} (${entry.requirementName})`
                                : " — elective"}
                            </span>
                            <form method="post" action="/api/plan-entries/remove" class="action-form action-form--remove">
                              <input type="hidden" name="courseCode" value={entry.courseCode} />
                              <button class="btn btn-ghost btn-remove">Remove</button>
                            </form>
                          </li>
                        ))
                      }
                    </ul>
                  </div>
                ))
              }
            </div>
          )
        }

        <div class="manual-add">
          <h3>Add any other course</h3>
          <p class="panel-hint">
            For an elective or out-of-degree course, or to plan ahead for something not yet
            recommended above.
          </p>
          {
            courseOptions.length === 0 ? (
              <p>Every seeded course is already in your plan.</p>
            ) : (
              <form method="post" action="/api/plan-entries" class="action-form action-form--manual">
                <label for="courseCode">Course</label>
                <select id="courseCode" name="courseCode" required>
                  {
                    courseOptions.map((course) => (
                      <option value={course.code}>
                        {course.code} — {course.title}
                      </option>
                    ))
                  }
                </select>

                <label for="year">Year</label>
                <input id="year" name="year" type="number" required min="2024" max="2035" />

                <label for="semester">Semester</label>
                <select id="semester" name="semester" required>
                  <option value="S1">S1</option>
                  <option value="S2">S2</option>
                </select>

                <label for="requirementCode">Requirement (optional)</label>
                <select id="requirementCode" name="requirementCode">
                  <option value="">— none (elective) —</option>
                  {
                    requirementOptions.map((requirement) => (
                      <option value={requirement.code}>
                        {requirement.degreeName}: {requirement.name}
                      </option>
                    ))
                  }
                </select>

                <button class="btn btn-secondary">Add to plan</button>
              </form>
            )
          }
        </div>
      </section>
    </main>
  </body>
</html>
